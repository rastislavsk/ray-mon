{
  "name": "ray-mon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kedy zapínať spotrebiče: živý výkon fotovoltiky, predpoveď výroby a odporúčania podľa tarify VT/NT.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/run.js",
    "test:e2e": "playwright test",
    "fixtures": "node test/fixtures/generate.js",
    "screenshots": "node test/screenshots/generate.js",
    "serve": "http-server -p 8080 -c-1 .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "lighthouse": "node test/lighthouse/obloha.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "http-server": "14.1.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
